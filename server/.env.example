# Server Port
PORT=5000

# MongoDB Connection String (Leave blank for in-memory DB during local dev, or provide MongoDB Atlas URI)
# Example: mongodb+srv://username:password@cluster0.xyz.mongodb.net/study_sync_romantic?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Expiry
JWT_SECRET=super_secret_romantic_key_2006_lovesync_token
JWT_EXPIRES_IN=30d

# Allowed Client Origin (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

NODE_ENV=development
